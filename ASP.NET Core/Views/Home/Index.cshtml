<h2>Getting Started with ButtonGroup</h2>

@(Html.DevExtreme().ButtonGroup()
    .Items(items => {
        items.Add().Icon("bold").Text("Bold");
        items.Add().Icon("italic").Text("Italic");
        items.Add().Icon("underline").Text("Underline");
        items.Add().Icon("strike").Text("Strike");
    })
    .KeyExpr("text")
    .SelectionMode(ButtonGroupSelectionMode.Multiple)
    .SelectedItemKeys(new[] { "Italic" })
    .OnSelectionChanged(@<text>
        function(e) {
            var selectedItemKeys = e.component.option('selectedItemKeys');
            var message;
            if (selectedItemKeys.length > 0) {
                message = 'The following styles are selected: ' + selectedItemKeys.join(', ');
            } else {
                message = 'There are no selected styles';
            }
            console.log(message);
        }
    </text>)
)